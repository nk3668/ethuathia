{
  // The lower layers, checked with no DOM types and no ambient globals. A `document`,
  // `window` or `setTimeout` reference in these folders fails to compile, which is what
  // keeps the sim runnable in a Web Worker, in tests and headless.
  // See docs/ARCHITECTURE.md §1.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": [],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.sim.tsbuildinfo"
  },
  "include": ["src/core", "src/content", "src/sim", "src/meta"]
}
